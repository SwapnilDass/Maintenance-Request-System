// the database design - prisma turns this into the postgres tables (the SQL is in prisma/migrations)
//
//   User      everyone who logs in, with a role (customer, technician, manager, admin)
//   Category  the kinds of problem (Electrical, Plumbing, HVAC, IT, Other)
//   Request   a maintenance request: who submitted it, its category, priority, status and assigned technician
//   Note      a progress note on a request (sprint 2)
//
// after changing this file: npx prisma migrate dev (makes a new migration + updates the tables)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// what each user is allowed to do (checked by middleware/requireRole.ts)
enum Role {
  CUSTOMER
  TECHNICIAN
  MANAGER
  ADMIN
}

// everyone who can log in. requests = the ones they submitted
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String // bcrypt hash, never the raw password
  name      String
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  requests  Request[] @relation("SubmittedRequests") // requests this user submitted

  // sprint 2
  assignedRequests Request[] @relation("AssignedRequests") // requests assigned to this technician
  notes            Note[] // progress notes this user wrote
}

// how urgent a request is - postgres keeps them in this order, so sorting puts URGENT first
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// the types of problems someone can report (Electrical, Plumbing, ...)
model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  requests Request[]
}

// a maintenance request submitted by a user
model Request {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  priority    Priority @default(MEDIUM)
  status      String   @default("Submitted") // Submitted -> Assigned -> In Progress -> Resolved (see src/lib/status.ts)
  createdAt   DateTime @default(now())

  userId     String
  user       User     @relation("SubmittedRequests", fields: [userId], references: [id])
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  // sprint 2 - the technician a manager assigned this to (empty until assigned, story #5)
  assignedTechnicianId String?
  assignedTechnician   User?   @relation("AssignedRequests", fields: [assignedTechnicianId], references: [id])

  notes Note[]
}

// a progress note on a request, ex. "ordered a new part, back Thursday" (story #7)
model Note {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade) // notes go away with their request
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
}
